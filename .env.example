# Server only. Never put service role or LiveKit secrets in VITE_ variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Comma-separated Supabase user UUIDs allowed to create hosted meetings.
HOST_USER_IDS=
PORT=3001
# Set to the exact number of trusted reverse-proxy hops (0 for direct access).
TRUST_PROXY_HOPS=0
