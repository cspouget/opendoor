# Copy this file to `.env` and replace the placeholders with your
# Supabase project details. The VITE_ prefix is required for Vite to
# expose these variables to the frontend at build time.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# LiveKit configuration: your server URL and token generation endpoint
VITE_LIVEKIT_URL=wss://your-livekit-server
# Note: tokens should be generated server‑side. See README for details.
